<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-transfer rules (Android 12+).
     Same set as backup_rules.xml: preferences + Room database only.
     No credentials, tokens, or secrets are stored in either location. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
