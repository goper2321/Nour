<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (Android 6-11) and Data Extraction (Android 12+) rules.
     Backs up user preferences (location, calculation method, theme, reading
     progress) and the local Room database (prayer logs, bookmarks, plans).
     No credentials, tokens, or secrets are stored in either location. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
</full-backup-content>
